# Application Configuration
APP_ENV=local
DEMO_MODE=true
NEXT_PUBLIC_APP_ENV=demo
NEXT_PUBLIC_DEMO_MODE=true
API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO
SESSION_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+asyncpg://praxisai:praxisai_local@localhost:5432/praxisai
DATABASE_MIGRATION_URL=
DATABASE_POOL_MODE=direct

# Supabase Storage (server-only; never expose the service-role key to Next.js)
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=internship-submissions
SUPABASE_STORAGE_TIMEOUT_SECONDS=30

# Supabase deployment example (keep real credentials outside the repository):
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# DATABASE_MIGRATION_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
# DATABASE_POOL_MODE=transaction

# Identity & Authentication (local auth is refused in production)
IDENTITY_PROVIDER=local
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=
COOKIE_SECURE=false

# Next.js Client Firebase Environment Variables
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Cloud and Vertex AI Gemini
GOOGLE_CLOUD_PROJECT=<PROJECT_ID>
GOOGLE_CLOUD_LOCATION=<REGION>
GEMINI_PROVIDER=fixture
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
CLOUD_TASKS_QUEUE=praxisai-staging-jobs
CLOUD_STORAGE_BUCKET=
BIGQUERY_DATASET=

# Funding (operator records independently verified external settlement evidence; no Stripe)
PAYMENT_PROVIDER=manual_external

# Credential Signing (demo or kms)
CREDENTIAL_SIGNING_PROVIDER=demo
CREDENTIAL_KMS_KEY_NAME=
CREDENTIAL_DEMO_PRIVATE_KEY_PATH=.local/keys/credential-private.pem
CREDENTIAL_ISSUER=PraxisAI Demo

# Notifications and Observability
EMAIL_PROVIDER=disabled
OTEL_EXPORTER_OTLP_ENDPOINT=

# Feature Flags
ENABLE_BIGQUERY_EXPORT=false
ENABLE_UNIVERSITY_ANALYTICS=true
UNIVERSITY_MINIMUM_COHORT_SIZE=5
