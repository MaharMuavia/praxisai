# Application Configuration
APP_ENV=local
DEMO_MODE=true
NEXT_PUBLIC_APP_ENV=demo
NEXT_PUBLIC_DEMO_MODE=true
API_BASE_URL=http://localhost:8000/api/v1
API_PROXY_TIMEOUT_MS=120000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
WEB_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET_FALLBACK=replace-with-at-least-32-random-characters
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_SECURE=false

# Supabase platform: PostgreSQL database, Auth, and private Storage.
# The publishable/anon key is browser-safe; the service-role key is server-only.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=internship-submissions
INTERNSHIP_MAX_UPLOAD_BYTES=31457280
OUTBOX_STALE_AFTER_SECONDS=2100
SUPABASE_STORAGE_TIMEOUT_SECONDS=30
STORAGE_PROVIDER=supabase

# Runtime uses the transaction pooler; Alembic uses the session/direct URL.
# Keep real URLs out of source control and URL-encode the database password.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
DATABASE_MIGRATION_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@SESSION_HOST:5432/postgres
DATABASE_POOL_MODE=transaction

# Supabase Auth. Local auth remains available only for local/demo/test workflows.
IDENTITY_PROVIDER=supabase

# Next.js browser variables. Never put SUPABASE_SERVICE_ROLE_KEY here.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gemini: fixture is local/demo only; use Vertex AI or GEMINI_API_KEY for live calls.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_PROVIDER=fixture
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Optional legacy GCS artifact adapter for non-hosted environments.
CLOUD_STORAGE_BUCKET=

# Funding (operator records independently verified external settlement evidence; no Stripe)
PAYMENT_PROVIDER=manual_external

# Credential signing (demo locally; KMS only when explicitly configured for production)
CREDENTIAL_SIGNING_PROVIDER=demo
CREDENTIAL_KMS_KEY_NAME=
CREDENTIAL_DEMO_PRIVATE_KEY_PATH=.local/keys/credential-private.pem
CREDENTIAL_ISSUER=PraxisAI Demo

# Notifications are in-app database records. Hosted alert delivery is configured
# as a Cloud Monitoring notification channel in Terraform.

# Feature Flags
ENABLE_UNIVERSITY_ANALYTICS=true
UNIVERSITY_MINIMUM_COHORT_SIZE=5
